{
  "name": "gather-workshops",
  "version": "1.0.0",
  "private": true,
  "description": "Community workshop discovery and booking application",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "verify": "npm run check && npm test",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
